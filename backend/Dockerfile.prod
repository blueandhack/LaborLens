FROM node:24-alpine AS profile-ui
WORKDIR /usr/src/app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build && npm prune --omit=dev

FROM node:24-alpine
WORKDIR /usr/src/app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY backend/ ./
# Employer pages use the same React components and assets as the browser.
COPY --from=profile-ui /usr/src/app/frontend/dist /usr/src/app/frontend/dist
COPY --from=profile-ui /usr/src/app/frontend/dist-ssr /usr/src/app/frontend/dist-ssr
COPY --from=profile-ui /usr/src/app/frontend/node_modules /usr/src/app/frontend/node_modules
EXPOSE 5001
CMD ["npm", "start"]
