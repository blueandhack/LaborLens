[Unit]
Description=Encrypted LaborLens MongoDB backup to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
Environment=RCLONE_CONFIG=/etc/laborlens-backup/rclone.conf
ExecStart=/usr/bin/python3 /opt/laborlens-backup/backup.py
TimeoutStartSec=8h
TimeoutStopSec=60s
Nice=15
CPUQuota=50%
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/laborlens-backup /etc/laborlens-backup
StateDirectory=laborlens-backup
StateDirectoryMode=0700
